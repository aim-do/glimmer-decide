# Glimmer: any OpenAI-compatible endpoint. Without GLIMMER_API_KEY the server runs in mock mode.
GLIMMER_BASE_URL=https://openrouter.ai/api/v1
GLIMMER_API_KEY=
GLIMMER_MODEL=meta/muse-glimmer-30b
# Together directly:   GLIMMER_BASE_URL=https://api.together.xyz/v1   GLIMMER_MODEL=<together model id>
# Own vLLM (Modal):    GLIMMER_BASE_URL=https://<app>.modal.run/v1      GLIMMER_MODEL=muse-glimmer
GLIMMER_REASONING=low
GLIMMER_MAX_TOKENS=4096
GLIMMER_TEMPERATURE=1.0

# Meta Model API key (hackathon $150 credits) - enables SAM 3.1 highlight. Optional.
MODEL_API_KEY=
SAM_MODEL=sam-3.1

# MOCK=1 forces offline fake decisions even with a key.
MOCK=0
