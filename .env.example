# Every key is optional: without any, run `python -m server --mock` for an offline demo.

# MetaEncoder ("Glimmer decision") on your own Modal GPU: `python deploy/setup_modal.py all`
# fills ENCODER_URL and ENCODER_TOKEN. It needs a Hugging Face read token that can see the
# gated facebook/meta-encoder weights (accept the terms on the model page first).
HF_TOKEN=
ENCODER_URL=
ENCODER_TOKEN=
# GPU for the deploy: any 80 GB card (H100 ~ $4/h, A100-80GB ~ $2.5/h on Modal).
ENCODER_GPU=H100
# Softmax temperature over cosine scores (only shapes the probabilities, not the choice).
ENCODER_TAU=0.02
# label: candidates are names, descriptions sit in the task's criteria block; label_detail: "name: description".
ENCODER_STYLE=label

# JevAny (decision head on Muse Glimmer 30B) on your own Modal GPU: `python deploy/setup_modal.py jevany`
# fills JEVANY_URL; it shares ENCODER_TOKEN. Open weights, no Hugging Face access request needed.
JEVANY_URL=
JEVANY_GPU=H100
# A fine-tuned run to serve instead of the released adapter (`modal run deploy/modal_jevany_train.py`
# prints its name); takes effect at the next Start. Empty = the released adapter.
JEVANY_RUN=

# Generative Glimmer (comparison / System 2): any OpenAI-compatible endpoint.
GLIMMER_BASE_URL=https://openrouter.ai/api/v1
GLIMMER_API_KEY=
GLIMMER_MODEL=meta/muse-glimmer-30b
GLIMMER_REASONING=low
GLIMMER_MAX_TOKENS=4096
GLIMMER_TEMPERATURE=1.0

# Meta Model API key (hackathon credits) - enables SAM 3.1 highlight. Optional.
MODEL_API_KEY=
SAM_MODEL=sam-3.1

# Encoder asks for another view when the top-2 cosine margin is below this.
ENCODER_MIN_MARGIN=0.05
# Hard deadline for one /api/decide call, seconds.
REQUEST_TIMEOUT_S=240

# Default decider: encoder | jevany | glimmer | both = every configured one (default: encoder when ENCODER_URL is set).
DECIDER=
# MOCK=1 -> offline fake decisions for UI work and tests. Never on implicitly.
MOCK=0
